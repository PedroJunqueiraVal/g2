class Produto {
    private int    id;
    private String nome;
    private String categoria;
    private double precoUnit;
    private double precoPromo;
    private int    qtdPromo;

    public Produto(int id, String nome, String categoria,
                   double precoUnit, double precoPromo, int qtdPromo) {
        this.id         = id;
        this.nome       = nome;
        this.categoria  = categoria;
        this.precoUnit  = precoUnit;
        this.precoPromo = precoPromo;
        this.qtdPromo   = qtdPromo;
    }

    public double calcularSubtotal(int qty) {
        if (qty <= 0) return 0;
        if (qtdPromo == 0 || precoPromo == 0) return precoUnit * qty;

        int    grupos   = qty / qtdPromo;
        int    resto    = qty % qtdPromo;
        return grupos * precoPromo + resto * precoUnit;
    }

    public int    getId()         { return id; }
    public String getNome()       { return nome; }
    public String getCategoria()  { return categoria; }
    public double getPrecoUnit()  { return precoUnit; }
    public double getPrecoPromo() { return precoPromo; }
    public int    getQtdPromo()   { return qtdPromo; }

    public void setNome(String nome)             { this.nome = nome; }
    public void setPrecoUnit(double precoUnit)   { this.precoUnit = precoUnit; }
    public void setPrecoPromo(double precoPromo) { this.precoPromo = precoPromo; }
}

class ItemPedido {
    private Produto produto;
    private int    quantidade;
    private double  subtotal;

    public ItemPedido(Produto produto, int quantidade) {
        this.produto    = produto;
        this.quantidade = quantidade;
        this.subtotal   = produto.calcularSubtotal(quantidade);
    }

    public void adicionarQuantidade(int qty) {
        this.quantidade += qty;
        this.subtotal    = produto.calcularSubtotal(this.quantidade);
    }

    public Produto getProduto()   { return produto; }
    public int     getQuantidade(){ return quantidade; }
    public double  getSubtotal()  { return subtotal; }
}

class Pedido {
    private String      cliente;
    private ItemPedido[] itens;
    private int         numItens;
    private double      total;
    private boolean     pago;

    private static final int MAX_ITENS = 20;

    public Pedido() {
        this.itens    = new ItemPedido[MAX_ITENS];
        this.numItens = 0;
        this.total    = 0;
        this.pago     = false;
    }

    public void adicionarItem(Produto produto, int qty) {
        for (int i = 0; i < numItens; i++) {
            if (itens[i].getProduto().getId() == produto.getId()) {
                total -= itens[i].getSubtotal();
                itens[i].adicionarQuantidade(qty);
                total += itens[i].getSubtotal();
                return;
            }
        }
        if (numItens < MAX_ITENS) {
            itens[numItens] = new ItemPedido(produto, qty);
            total += itens[numItens].getSubtotal();
            numItens++;
        }
    }

    public ItemPedido[] getItens() {
        ItemPedido[] resultado = new ItemPedido[numItens];
        System.arraycopy(itens, 0, resultado, 0, numItens);
        return resultado;
    }

    public String  getCliente()  { return cliente; }
    public int     getNumItens() { return numItens; }
    public double  getTotal()    { return total; }
    public boolean isPago()      { return pago; }

    public void setCliente(String cliente) { this.cliente = cliente; }
    public void setPago(boolean pago)      { this.pago = pago; }
}
