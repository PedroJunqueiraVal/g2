    static int lerInteiro(int min, int max) {
        while (true) {
            System.out.print("  > ");
            String linha = sc.nextLine().trim();
            try {
                int v = Integer.parseInt(linha);
                if (v >= min && v <= max) return v;
            } catch (NumberFormatException ignored) {}
            System.out.printf("  Valor invalido. Digite entre %d e %d: %n", min, max);
        }
    }

    static Produto[] filtrarPorCategoria(String cat) {
        return java.util.Arrays.stream(catalogo)
            .filter(p -> p.getCategoria().equals(cat))
            .toArray(Produto[]::new);
    }

    static Produto[] filtrarPorNomeInicio(String prefixo) {
        return java.util.Arrays.stream(catalogo)
            .filter(p -> p.getNome().startsWith(prefixo))
            .toArray(Produto[]::new);
    }

